import class Sink from './support/sink.atto';
import * as rx_callbacks from '../src/rx.ores';
import class Observable from '../src/rx.ores';

pub fnc main(): void {
  val Observable<int> source = rx_callbacks.from_values([1, 2, 3, 4, 5]);
  val Fnc<int, int> twice = |value| -> {
    val int item = value as int;
    return item * 2;
  };
  val Observable<int> doubled = rx_callbacks.map(source, twice);
  val Fnc<int, bool> large = |value| -> {
    val int item = value as int;
    return item > 4;
  };
  val Observable<int> selected = rx_callbacks.filter(doubled, large);
  val Observable<int> limited = rx_callbacks.take(selected, 2);
  val Fnc<int, bool> sink = |value| -> {
    return true;
  };

  stdio.println(rx_callbacks.for_each(limited, sink));
  // Callback-side assertions; no snapshot-only credit for take/filter.
  val Sink one = new Sink(0);
  rx_callbacks.for_each(rx_callbacks.take(rx_callbacks.from_values([6, 7, 8]), 1), one.accept);
  if one.count != 1; then Err("take(1) count").expect("rx assertion"); fi
  val Sink none = new Sink(0);
  val Fnc<int, bool> none_match = |value| -> { return false; };
  rx_callbacks.for_each(rx_callbacks.filter(rx_callbacks.from_values([1, 2]), none_match), none.accept);
  if none.count != 0; then Err("filter(false) count").expect("rx assertion"); fi
  return;
}
